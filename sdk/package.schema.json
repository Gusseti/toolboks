{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Toolboks add-on package - API 1 and 2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "long_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "icon": {
          "enum": [
            "grid",
            "activity",
            "layers",
            "storage",
            "wrench",
            "leaf"
          ]
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "api_version": {
          "enum": [
            1,
            2
          ]
        },
        "min_toolboks_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "website": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048
        },
        "support_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048
        },
        "license": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 100
        },
        "screenshots": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^https://[^\\s]+$",
            "maxLength": 2048
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "host_metrics",
              "local_preferences",
              "filesystem_read",
              "user_exports",
              "drive_optimize"
            ]
          }
        },
        "byline": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 60
        },
        "native_provider": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "long_description",
        "version",
        "author",
        "publisher",
        "category",
        "icon",
        "accent",
        "api_version",
        "min_toolboks_version"
      ]
    },
    "pages": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "widgets": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "heading"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 180
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8000
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "note"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "kind",
                    "title",
                    "text"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "metric"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "binding": {
                      "enum": [
                        "memory_percent",
                        "memory_available",
                        "memory_total",
                        "uptime"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "label",
                    "binding"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "toggle"
                    },
                    "key": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 180
                    },
                    "default": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kind",
                    "key",
                    "label"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "text_input"
                    },
                    "key": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 180
                    },
                    "default": {
                      "type": "string",
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "kind",
                    "key",
                    "label"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "widgets"
        ]
      }
    },
    "tutorial": {
      "items": {
        "required": [
          "page",
          "target",
          "title",
          "description"
        ],
        "properties": {
          "description": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "page": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "target": {
            "type": "string",
            "pattern": "^(page|widget-[0-9]+)$"
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "type": "array",
      "maxItems": 300
    }
  },
  "required": [
    "schema_version",
    "manifest",
    "pages"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "manifest": {
            "required": [
              "native_provider"
            ],
            "properties": {
              "native_provider": {
                "type": "string"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "manifest": {
            "properties": {
              "api_version": {
                "const": 2
              }
            }
          },
          "pages": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "pages": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
