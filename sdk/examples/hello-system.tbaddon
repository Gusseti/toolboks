{
  "schema_version": 1,
  "manifest": {
    "id": "com.example.hello-system",
    "title": "Hello System",
    "description": "A small, working example of an integrated Toolboks add-on.",
    "long_description": "Built with the Toolboks Add-on SDK. This example combines live memory readings with preferences that survive an app restart. Its pages render directly inside the Toolboks workspace.",
    "version": "1.0.0",
    "author": "SDK example",
    "publisher": "Example developer",
    "category": "Developer tools",
    "icon": "leaf",
    "accent": "#8B5CF6",
    "api_version": 1,
    "min_toolboks_version": "0.8.2",
    "license": "MIT",
    "capabilities": ["host_metrics", "local_preferences"]
  },
  "pages": [
    {"id":"overview","title":"Overview","widgets":[
      {"kind":"heading","text":"Your system at a glance"},
      {"kind":"text","text":"This add-on runs inside Toolboks and uses its look, so you do not style anything yourself."},
      {"kind":"metric","label":"Memory in use","binding":"memory_percent"},
      {"kind":"metric","label":"Available memory","binding":"memory_available"},
      {"kind":"metric","label":"System uptime","binding":"uptime"},
      {"kind":"note","title":"Make it yours","text":"Open Preferences and change a value. Your choice is kept on this PC and is still there after a restart."}
    ]},
    {"id":"preferences","title":"Preferences","widgets":[
      {"kind":"heading","text":"Preferences"},
      {"kind":"toggle","key":"show_details","label":"Show detailed information","default":true},
      {"kind":"text_input","key":"label","label":"A name for this PC","default":"My workstation"}
    ]}
  ]
}
